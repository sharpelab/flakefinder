#!/bin/bash
# sls: Run commands on the microscope via Git Bash
# Pipes commands via stdin to bypass PowerShell command interpretation.
#
# Usage: sls <script.py> [args...]   →  uv run python <script> <args>
#        sls git <cmd> [args...]     →  git <cmd> <args>
#        sls push <path>...          →  rsync local→remote (mkdir -p as needed)
#        sls pull <path>...          →  rsync remote→local
#        sls -- <cmd> [args...]      →  <cmd> <args> (raw)
# Paths for push/pull are relative to the flakefinder repo root.
REMOTE="sharpelab-microscope"
BASH='"C:\Program Files\Git\bin\bash.exe"'

REPO=flakefinder

case "$1" in
    push)
        shift
        for path in "$@"; do
            parent="$REPO/$(dirname "$path")"
            ssh "$REMOTE" "$BASH" -c "$(printf '%q' "mkdir -p $parent")"
            rsync -a --quiet "$path" "$REMOTE:$REPO/$path"
        done
        exit 0
        ;;
    pull)
        shift
        for path in "$@"; do
            mkdir -p "$(dirname "$path")"
            rsync -a --quiet "$REMOTE:$REPO/$path" "$path"
        done
        exit 0
        ;;
    git) shift; CMD="git $(printf '%q ' "$@")"; DIR="$REPO" ;;
    --)  shift; CMD="$(printf '%q ' "$@")"; DIR=. ;;
    *)   CMD="uv run python $(printf '%q ' "$@")"; DIR="$REPO" ;;
esac

ssh "$REMOTE" "$BASH" <<EOF
cd $DIR
$CMD
EOF
