#!/bin/bash
# Launch Claude Code as scan operator
REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

if [[ "$1" == "--spawn" ]]; then
    shift
    alacritty --working-directory "$REPO_DIR" -e env -u CLAUDECODE "$0" "$@" &
    exit 0
fi

cd "$REPO_DIR"
export PATH="$REPO_DIR/tools:$PATH"
claude --append-system-prompt-file "$REPO_DIR/.claude/commands/scan.md" "$@"
