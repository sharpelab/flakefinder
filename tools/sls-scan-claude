#!/bin/bash
# Launch Claude Code as scan operator
REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

if [[ "$1" == "--spawn" ]]; then
    shift
    wezterm start --always-new-process --cwd "$REPO_DIR" -- "$0" "$@" &
    exit 0
fi

cd "$REPO_DIR"
export PATH="$REPO_DIR/tools:$PATH"
claude --model opus --append-system-prompt-file "$REPO_DIR/.claude/commands/scan.md" "$@"
