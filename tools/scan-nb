#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# ///
"""Append a timestamped entry to a scan notebook.

Finds "Scan Notebook - <slug>.md" in ~/Documents/Primer/Sharpelab/Scan Notebooks/.
Auto-prepends **MM-DD HH:MM** timestamp. Appends before <!-- end-of-log --> sentinel.

Usage:
  scan-nb <slug> "entry text"
  scan-nb <slug> --create "entry text"
  scan-nb <slug> --attach src.png "text with ![[src.png]]"
  scan-nb <slug> --attach src.png:dest.png "text with ![[dest.png]]"
  echo "text" | scan-nb <slug>

Flags:
  --create              Create notebook from template if it doesn't exist (no-op if it does).
  --attach src[:dest]   Copy src to attachments/ dir (optionally renamed to dest).
                        Repeatable. Entry must reference each attachment as ![[name]]
                        or the command errors (gmail-style validation).
                        Fails if dest already exists in attachments/.

Errors:
  - Notebook not found for given slug (without --create)
  - <!-- end-of-log --> sentinel missing from notebook
  - Attachment source file not found
  - Attachment not referenced in entry text
"""

import re
import shutil
import sys
from datetime import datetime
from pathlib import Path

VAULT_DIR = Path.home() / "Documents" / "Primer" / "Sharpelab"
NB_DIR = VAULT_DIR / "Scan Notebooks"
ATTACH_DIR = VAULT_DIR / "attachments"
SENTINEL = "<!-- end-of-log -->"

TEMPLATE = """\
# Scan Notebook - [YYYY-MM-DD]

[Brief description: new sample set, revisiting previous samples, specific experiment, etc.]

## Current State

- **Objective**: [5x / 20x]
- **5x overview scan**: `scans/[prefix]_overview_5x/`
- **Stitch**: `scans/[prefix]_overview_5x_stitch.jpg`
- **Detection**: `scans/[prefix]_overview_5x_stitch_chips_detected.png`

### Chips

| Chip | Center (mm) | Area (mm2) | Notes |
|------|-------------|------------|-------|
| 0 | | | |

### Z Focus

- Reference Z from previous set: ~_____ um
- Current set offset: _____ um from reference
- Chip 0 centroid: ~_____ um (20x, 1/4 speed)

## Log

<!-- end-of-log -->
"""


def die(msg):
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(1)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0 if args else 1)

    slug = args.pop(0)
    if slug.startswith("--"):
        die(f"expected slug as first argument, got '{slug}' (usage: scan-nb <slug> [--create] \"text\")")
    nb = NB_DIR / f"Scan Notebook - {slug}.md"

    # Parse --create, --attach flags, and entry text
    create = False
    attachments = []  # list of (src_path, dest_name)
    text = None

    i = 0
    while i < len(args):
        if args[i] == "--create":
            create = True
        elif args[i] == "--attach":
            i += 1
            if i >= len(args):
                die("--attach requires an argument")
            spec = args[i]
            if ":" in spec:
                src, dest = spec.rsplit(":", 1)
            else:
                src = spec
                dest = Path(spec).name
            src_path = Path(src)
            if not src_path.exists():
                die(f"attachment not found: {src_path}")
            attachments.append((src_path, dest))
        elif args[i].startswith("--"):
            die(f"unknown flag: {args[i]}")
        else:
            text = args[i]
        i += 1

    # Create notebook from template if --create and it doesn't exist
    if not nb.exists():
        if create:
            nb.write_text(TEMPLATE.replace("[YYYY-MM-DD]", slug))
            print(f"Created {nb.name}")
        else:
            die(f"{nb} not found")
    elif create:
        print(f"{nb.name} already exists")

    if text is None:
        if not sys.stdin.isatty():
            text = sys.stdin.read().rstrip()
        else:
            die("no entry text provided")

    # Validate all attachments are referenced in entry
    for _, dest in attachments:
        if f"![[{dest}]]" not in text:
            die(f"attachment '{dest}' not referenced in entry (expected ![[{dest}]])")

    # Validate attachment destinations don't already exist
    if attachments:
        ATTACH_DIR.mkdir(exist_ok=True)
        for _, dest in attachments:
            dest_path = ATTACH_DIR / dest
            if dest_path.exists():
                die(f"attachment already exists: {dest_path}\n  Hint: use --attach src.png:new_name.png to rename")

    # Validate all ![[ref]] in entry text resolve to existing or about-to-be-copied attachments
    pending_names = {dest for _, dest in attachments}
    for ref in re.findall(r"!\[\[(.+?)]]", text):
        if ref not in pending_names and not (ATTACH_DIR / ref).exists():
            die(f"entry references ![[{ref}]] but no such file in {ATTACH_DIR}")

    # Strip leading timestamp (scan-nb adds these automatically)
    stripped = re.sub(r"^\*\*\d{2}-\d{2}\s+\d{2}:\d{2}\*\*\s*", "", text)
    if stripped != text:
        print("Note: stripped leading timestamp — scan-nb adds these automatically", file=sys.stderr)
        text = stripped

    # Strip trailing --- (scan-nb adds separators automatically)
    stripped = re.sub(r"\n---\s*$", "", text)
    if stripped != text:
        print("Note: stripped trailing '---' — scan-nb adds separators automatically", file=sys.stderr)
        text = stripped

    # --- All validation passed, now write ---

    # Copy attachments
    for src_path, dest in attachments:
        shutil.copy2(src_path, ATTACH_DIR / dest)

    # Build and write entry
    ts = datetime.now().strftime("%m-%d %H:%M")
    entry = f"**{ts}**\n{text}\n\n---\n\n{SENTINEL}"

    # Append to notebook
    content = nb.read_text()
    if SENTINEL not in content:
        die(f"sentinel not found in {nb}")
    nb.write_text(content.replace(SENTINEL, entry))


if __name__ == "__main__":
    main()
