#!/bin/sh
# Pre-commit hook: run ruff and ty on staged Python files
# Setup: git config core.hooksPath hooks/

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')
[ -z "$STAGED" ] && exit 0

uv run ruff check --fix $STAGED && uv run ruff format $STAGED

# Re-stage files that ruff modified
echo "$STAGED" | xargs git add

# Type check (per-file overrides in pyproject.toml handle exclusions)
uvx ty check $STAGED
